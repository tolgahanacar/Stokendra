<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stokendra.ViewModels"
             xmlns:infra="using:Stokendra.Infrastructure"
             x:Class="Stokendra.Views.GuideView"
             Background="#0C0E14"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,24,32,24">
        
        <!-- Header Section -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{infra:L guide_title}" FontSize="28" FontWeight="Black" Foreground="#F8FAFC"/>
            <TextBlock Text="{infra:L guide_subtitle}" FontSize="13" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- System Metadata Info Card -->
        <Border Grid.Row="1" Classes="Card" Background="#111827" BorderBrush="#1F2937" CornerRadius="10" Padding="18,12" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Spacing="2" Margin="0,0,32,4">
                    <TextBlock Text="{infra:L guide_app_version}" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="13" Foreground="#38AEFF" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,32,4">
                    <TextBlock Text="{infra:L guide_db_path}" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DatabasePath}" FontSize="12" Foreground="#D0D8F0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,0,4">
                    <TextBlock Text="{infra:L guide_settings_path}" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SettingsPath}" FontSize="12" Foreground="#D0D8F0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Search Box -->
        <Border Grid.Row="2" Background="#161B27" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText}"
                         Watermark="{infra:L guide_search_placeholder}"
                         Background="#0C0E14"
                         BorderBrush="#252F44"
                         BorderThickness="1"
                         CornerRadius="8"
                         FontSize="13"
                         Padding="12,8"/>
                <Button Grid.Column="1"
                        Content="{infra:L clear_filter}"
                        Classes="Secondary"
                        Command="{Binding ClearSearchCommand}"
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Tab Content Switcher -->
        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Margin" Value="0,0,8,12"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
                <Style Selector="TabItem:pointerover">
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                </Style>
                <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="#334155"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#60A5FA"/>
                </Style>
                <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="#312E81"/>
                </Style>
            </TabControl.Styles>

            <!-- 👥 USER GUIDE TAB -->
            <TabItem Header="{infra:L guide_tab_user}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="0" Margin="0,8,0,0">
                        <!-- No Results Warning -->
                        <Border IsVisible="{Binding !HasUserResults}" Classes="Card" Background="#111827" BorderBrush="#1F2937" Padding="24" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                            <TextBlock Text="{infra:L guide_no_results}" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FilteredUserCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GuideCardItem">
                                    <Border Classes="Card" Background="#111827" BorderBrush="#1F2937" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                        <Grid ColumnDefinitions="48,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Border Background="{Binding TagBg}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="{Binding TagColor}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#D0D8F0" TextWrapping="Wrap" LineHeight="21"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 💻 DEVELOPER ROADMAP TAB -->
            <TabItem Header="{infra:L guide_tab_dev}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="0" Margin="0,8,0,0">
                        <!-- No Results Warning -->
                        <Border IsVisible="{Binding !HasDevResults}" Classes="Card" Background="#111827" BorderBrush="#1F2937" Padding="24" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                            <TextBlock Text="{infra:L guide_no_results}" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FilteredDevCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GuideCardItem">
                                    <Border Classes="Card" Background="#111827" BorderBrush="#1F2937" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                        <Grid ColumnDefinitions="48,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Border Background="{Binding TagBg}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="{Binding TagColor}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#D0D8F0" TextWrapping="Wrap" LineHeight="21"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
