<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stokendra.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:infra="using:Stokendra.Infrastructure"
             xmlns:views="using:Stokendra.Views"
             x:Class="Stokendra.Views.ReportsView"
             Background="#0C0E14" x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="40,28,40,0" Spacing="6">
            <TextBlock Text="{infra:L reports}" FontSize="28" FontWeight="Bold" Foreground="#F1F5F9"/>
            <TextBlock Text="{infra:L reports_subtitle}" FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="40,16,40,20">

                <!-- Filtreler -->
                <Border Background="#161B27"
                        CornerRadius="12" Padding="20,14"
                        BorderBrush="#1E2D45" BorderThickness="1">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Spacing="4" Margin="0,0,16,8">
                            <TextBlock Text="{infra:L start_date}" FontSize="11" Foreground="#94A3B8"/>
                            <views:SafeCalendarDatePicker SelectedDate="{Binding StartDate}" Width="150"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8">
                            <TextBlock Text="{infra:L end_date}" FontSize="11" Foreground="#94A3B8"/>
                            <views:SafeCalendarDatePicker SelectedDate="{Binding EndDate}" Width="150"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8">
                            <TextBlock Text="{infra:L department}" FontSize="11" Foreground="#94A3B8"/>
                            <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" Width="160"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8">
                            <TextBlock Text="{infra:L stock_card_header}" FontSize="11" Foreground="#94A3B8"/>
                            <ComboBox ItemsSource="{Binding StockCards}" SelectedItem="{Binding SelectedStockCard}" Width="190"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8">
                            <TextBlock Text="{infra:L category}" FontSize="11" Foreground="#94A3B8"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="160"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8">
                            <TextBlock Text="{infra:L recipient}" FontSize="11" Foreground="#94A3B8"/>
                            <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Width="160"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                            <Button Content="{infra:L report_al}" Classes="Primary" Command="{Binding GenerateReportCommand}" Margin="0,0,8,6"/>
                            <Button Content="{infra:L print}" Classes="Success" Command="{Binding PrintCommand}" Margin="0,0,8,6"/>
                            <Button Content="{infra:L export_excel}" Classes="Secondary" Command="{Binding ExportCommand}" Margin="0,0,8,6"/>
                            <Button Content="{infra:L clear_filter}" Classes="Secondary" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </WrapPanel>
                </Border>

                <!-- İstatistik Kartları ve Grafik -->
                <Grid ColumnDefinitions="*,280" Height="240">
                    <!-- Grafik -->
                    <Border Grid.Column="0" Background="#161B27" CornerRadius="12" BorderBrush="#1E2D45" BorderThickness="1" Margin="0,0,16,0">
                        <Grid>
                            <sp:AvaPlot Name="ConsumptionChart" Margin="10"/>
                            <Border IsVisible="{Binding !IsLoading}" IsHitTestVisible="False">
                                <TextBlock Text="{infra:L report_no_data}"
                                           IsVisible="{Binding ReportRows.Count, Converter={StaticResource ZeroToBoolConverter}}"
                                           Foreground="#64748B" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="20"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Küçük Kartlar -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <Border Background="#161B27" CornerRadius="12" Padding="18" BorderBrush="#1E2D45" BorderThickness="1" Height="112">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{infra:L total_consumption}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding TotalConsumption}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6"/>
                                <TextBlock Text="{infra:L unit_material_exit}" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#161B27" CornerRadius="12" Padding="18" BorderBrush="#1E2D45" BorderThickness="1" Height="112">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{infra:L unique_items}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding UniqueItemCount}" FontSize="28" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="{infra:L different_material_items}" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Liste -->
                <Border Background="#161B27"
                        CornerRadius="12" BorderBrush="#1E2D45" BorderThickness="1">
                    <Grid>
                        <DataGrid ItemsSource="{Binding ReportRows}"
                                  MinHeight="260" MaxHeight="440"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{infra:L code_no}" Binding="{Binding StockCardCode}" Width="100" MinWidth="80"/>
                                <DataGridTextColumn Header="{infra:L stock_name}" Binding="{Binding StockCardName}" Width="2*" MinWidth="130"/>
                                <DataGridTextColumn Header="{infra:L quantity}" Binding="{Binding Quantity}" Width="85" MinWidth="65"/>
                                <DataGridTextColumn Header="{infra:L delivered_to}" Binding="{Binding Recipient}" Width="*" MinWidth="110"/>
                                <DataGridTextColumn Header="{infra:L department}" Binding="{Binding Department}" Width="*" MinWidth="110"/>
                                <DataGridTextColumn Header="{infra:L date}" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="145" MinWidth="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border IsVisible="{Binding !IsLoading}" IsHitTestVisible="False">
                            <TextBlock Text="{infra:L report_no_data}"
                                       IsVisible="{Binding ReportRows.Count, Converter={StaticResource ZeroToBoolConverter}}"
                                       Foreground="#64748B" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="20"/>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsLoading}"/>

        <!-- Status -->
        <Border Grid.Row="2" Background="#0E1119" Padding="40,8">
            <TextBlock Text="{Binding StatusText}" Foreground="#475569" FontSize="12"/>
        </Border>

    </Grid>
</UserControl>
