<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stokendra.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:Class="Stokendra.Views.ReportsView"
             Background="#0C0E14">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        
        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="40,32,40,0" Spacing="6">
            <TextBlock Text="Gelişmiş Raporlar" FontSize="28" FontWeight="Bold" Foreground="#F1F5F9"/>
            <TextBlock Text="Tüketim analizleri ve istatistiksel veriler" FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- Filtreler -->
        <Border Grid.Row="1" Background="#161B27" Margin="40,20,40,0"
                CornerRadius="12" Padding="20,14"
                BorderBrush="#1E2D45" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Spacing="4" Margin="0,0,16,8">
                    <TextBlock Text="Başlangıç" FontSize="11" Foreground="#94A3B8"/>
                    <CalendarDatePicker SelectedDate="{Binding StartDate}" Width="150"/>
                </StackPanel>
                <StackPanel Spacing="4" Margin="0,0,16,8">
                    <TextBlock Text="Bitiş" FontSize="11" Foreground="#94A3B8"/>
                    <CalendarDatePicker SelectedDate="{Binding EndDate}" Width="150"/>
                </StackPanel>
                <StackPanel Spacing="4" Margin="0,0,16,8">
                    <TextBlock Text="Departman" FontSize="11" Foreground="#94A3B8"/>
                    <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" Width="160"/>
                </StackPanel>
                <StackPanel Spacing="4" Margin="0,0,16,8">
                    <TextBlock Text="Kategori" FontSize="11" Foreground="#94A3B8"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="160"/>
                </StackPanel>
                <StackPanel Spacing="4" Margin="0,0,16,8">
                    <TextBlock Text="Personel" FontSize="11" Foreground="#94A3B8"/>
                    <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Width="160"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="📊 Raporla" Classes="Primary" Command="{Binding GenerateReportCommand}"/>
                    <Button Content="⎙ Yazdır" Classes="Success" Command="{Binding PrintCommand}"/>
                    <Button Content="📊 Excel" Classes="Secondary" Command="{Binding ExportCommand}"/>
                    <Button Content="↺ Temizle" Classes="Secondary" Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- İstatistik Kartları ve Grafik -->
        <Grid Grid.Row="2" Margin="40,20,40,0" ColumnDefinitions="*,300" Height="280">
            <!-- Grafik -->
            <Border Grid.Column="0" Background="#161B27" CornerRadius="12" BorderBrush="#1E2D45" BorderThickness="1" Margin="0,0,16,0">
                <sp:AvaPlot Name="ConsumptionChart" Margin="10"/>
            </Border>
            
            <!-- Küçük Kartlar -->
            <StackPanel Grid.Column="1" Spacing="16">
                <Border Background="#161B27" CornerRadius="12" Padding="20" BorderBrush="#1E2D45" BorderThickness="1" Height="132">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TOPLAM TÜKETİM" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding TotalConsumption}" FontSize="32" FontWeight="Bold" Foreground="#3B82F6"/>
                        <TextBlock Text="birim malzeme çıkışı" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
                <Border Background="#161B27" CornerRadius="12" Padding="20" BorderBrush="#1E2D45" BorderThickness="1" Height="132">
                    <StackPanel Spacing="8">
                        <TextBlock Text="BENZERSİZ ÜRÜN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding UniqueItemCount}" FontSize="32" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="farklı kalem malzeme" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Liste -->
        <Border Grid.Row="3" Background="#161B27" Margin="40,20,40,20"
                CornerRadius="12" BorderBrush="#1E2D45" BorderThickness="1">
            <DataGrid ItemsSource="{Binding ReportRows}" IsReadOnly="True" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Malzeme Adı" Binding="{Binding StockCardName}" Width="250"/>
                    <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="Teslim Edilen" Binding="{Binding Recipient}" Width="200"/>
                    <DataGridTextColumn Header="Departman" Binding="{Binding Department}" Width="300"/>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="250"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4" Background="#0E1119" Padding="40,8">
            <TextBlock Text="{Binding StatusText}" Foreground="#475569" FontSize="12"/>
        </Border>

    </Grid>
</UserControl>
