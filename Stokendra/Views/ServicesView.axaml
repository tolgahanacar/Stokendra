<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Stokendra.Infrastructure"
             x:Class="Stokendra.Views.ServicesView"
             Background="#0C0E14" x:CompileBindings="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="40,32,40,0" Spacing="6">
            <TextBlock Text="{infra:L services}" FontSize="28" FontWeight="Bold" Foreground="#F1F5F9"/>
            <TextBlock Text="{infra:L services_subtitle}" FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- Filtreler -->
        <Border Grid.Row="1" Background="#161B27" Margin="40,20,40,0"
                CornerRadius="12" Padding="20,14"
                BorderBrush="#1E2D45" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="{infra:L service_search_placeholder}"
                         Width="260" Margin="0,0,10,8"/>
                <CalendarDatePicker SelectedDate="{Binding StartDate}" Width="150" Margin="0,0,10,8"/>
                <CalendarDatePicker SelectedDate="{Binding EndDate}" Width="150" Margin="0,0,10,8"/>
                <Button Content="{infra:L filter}" Classes="Primary"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,8,8"/>
                <Button Content="{infra:L clear_filter}" Classes="Secondary"
                        Command="{Binding ClearFiltersCommand}"
                        Margin="0,0,8,8"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="40,14,40,0">
            <Button Content="{infra:L add}" Classes="Primary"
                    Command="{Binding AddCommand}"
                    IsVisible="{Binding CanEdit}"/>
            <Button Content="{infra:L edit}" Classes="Secondary"
                    Command="{Binding EditCommand}"
                    IsEnabled="{Binding IsRecordSelected}"
                    IsVisible="{Binding CanEdit}"/>
            <Button Content="{infra:L delete}" Classes="Danger"
                    Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding IsRecordSelected}"
                    IsVisible="{Binding CanEdit}"/>
            <Rectangle Width="1" Height="22" Fill="#1E2D45" Margin="4,0" IsVisible="{Binding CanEdit}"/>
            <Button Content="{infra:L excel}" Classes="Secondary"
                    Command="{Binding ExportExcelCommand}"/>
            <Button Content="{infra:L print}" Classes="Success"
                    Command="{Binding PrintCommand}"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3"
                  Name="ServicesGrid"
                  Margin="40,16,40,16"
                  ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord}"
                  SelectionMode="Extended"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  Background="#0C0E14"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{infra:L device_name}"  Binding="{Binding DeviceName}"     Width="250"/>
                <DataGridTextColumn Header="{infra:L serial_number}"    Binding="{Binding SerialNumber}"  Width="200"/>
                <DataGridTextColumn Header="{infra:L company}"      Binding="{Binding Company}"         Width="180"/>
                <DataGridTextColumn Header="{infra:L problem}"      Binding="{Binding Issue}"         Width="250"/>
                <DataGridTextColumn Header="{infra:L result}"      Binding="{Binding Result}"         Width="250"/>
                <DataGridTextColumn Header="{infra:L date}"      Binding="{Binding ServiceDate, StringFormat=dd.MM.yyyy}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="#0E1119" Padding="40,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="◀" Command="{Binding PrevPageCommand}" Classes="Secondary" Padding="8,2"/>
                    <TextBlock Text="{Binding CurrentPage}" Foreground="#F1F5F9" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="/" Foreground="#475569" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPages}" Foreground="#475569" VerticalAlignment="Center"/>
                    <Button Content="▶" Command="{Binding NextPageCommand}" Classes="Secondary" Padding="8,2"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
