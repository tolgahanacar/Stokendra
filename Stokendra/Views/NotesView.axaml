<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stokendra.ViewModels"
             xmlns:infra="using:Stokendra.Infrastructure"
             x:Class="Stokendra.Views.NotesView"
             Background="#0C0E14"
             x:CompileBindings="False">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Delete" 
                     Command="{Binding DeleteSelectedCommand}" 
                     CommandParameter="{Binding #NotesGrid.SelectedItems}"/>
    </UserControl.KeyBindings>

    <Grid ColumnDefinitions="350,*">

        <!-- Left: Notes List -->
        <Border Grid.Column="0" Background="#0E1119" BorderBrush="#1E2535" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Title and Status -->
                <StackPanel Grid.Row="0" Margin="24,32,24,0" Spacing="4">
                    <TextBlock Text="{infra:L notes}" FontSize="26" FontWeight="Bold" Foreground="#E8EEFF"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#64748B"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="1" Margin="24,20,24,12" Spacing="8">
                    <!-- Editor Actions -->
                    <StackPanel Spacing="8" IsVisible="{Binding CanEdit}">
                        <Button Content="{infra:L new_note}" Classes="Primary"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Height="40"
                                Command="{Binding NewNoteCommand}"/>
                        
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <Button Content="{infra:L edit}" Classes="Secondary" Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding EditNoteCommand}"
                                    IsEnabled="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <Button Content="{infra:L delete}" Classes="Danger" Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding DeleteSelectedCommand}"
                                    CommandParameter="{Binding #NotesGrid.SelectedItems}"
                                    IsEnabled="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </UniformGrid>
                    </StackPanel>
                    
                    <!-- Export Action -->
                    <Button Content="{infra:L export_excel}" Classes="Secondary"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="36"
                            Command="{Binding ExportExcelCommand}"/>
                </StackPanel>

                <!-- List -->
                <ListBox Grid.Row="2"
                          Name="NotesGrid"
                          Margin="12,0"
                          ItemsSource="{Binding Notes}"
                          SelectedItem="{Binding SelectedNote}"
                          SelectionMode="Multiple, Toggle"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected Border.NoteCard">
                            <Setter Property="BorderBrush" Value="#38AEFF"/>
                            <Setter Property="Background" Value="#1A2235"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border.NoteCard">
                            <Setter Property="BorderBrush" Value="#2A3C5A"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="NoteCard" 
                                    Padding="16,14" CornerRadius="10" 
                                    Background="#161B27"
                                    BorderBrush="#1E2D45" BorderThickness="1">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Grid.Column="0" 
                                              Margin="0,0,16,0" 
                                              IsChecked="{Binding $parent[ListBoxItem].IsSelected, Mode=OneWay}"
                                              IsHitTestVisible="False" 
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="#F1F5F9"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="🕒" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                       FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right: Detail / Edit -->
        <Grid Grid.Column="1" Background="#0C0E14" RowDefinitions="*,Auto">
            
            <!-- View Mode -->
            <ScrollViewer Grid.Row="0" IsVisible="{Binding !IsEditing}">
                <StackPanel Margin="40,32" Spacing="20"
                            IsVisible="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SelectedNote.Title}"
                                   FontSize="28" FontWeight="ExtraBold" Foreground="#F1F5F9"
                                   TextWrapping="Wrap"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="16" Opacity="0.7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{infra:L created}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SelectedNote.CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                           FontSize="12" Foreground="#38AEFF" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{infra:L updated}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SelectedNote.UpdatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                           FontSize="12" Foreground="#38AEFF" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#1E2D45"/>

                    <TextBlock Text="{Binding SelectedNote.Content}"
                               FontSize="16" Foreground="#CBD5E1"
                               TextWrapping="Wrap" LineHeight="26"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Edit Mode -->
            <ScrollViewer Grid.Row="0" IsVisible="{Binding IsEditing}">
                <StackPanel Margin="40,32" Spacing="20">
                    <TextBlock Text="{infra:L note_edit_title}" FontSize="20" FontWeight="Bold" Foreground="#38AEFF"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="{infra:L title}" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding EditTitle}" 
                                 Watermark="{infra:L note_title_placeholder}"
                                 FontSize="15" Padding="12"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{infra:L date_label}" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding EditCreatedAt}" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{infra:L content}" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding EditContent}"
                                 Watermark="{infra:L note_content_placeholder}"
                                 AcceptsReturn="True"
                                 MinHeight="400"
                                 FontSize="15" Padding="12"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Buttons -->
            <Border Grid.Row="1" Background="#0E1119" BorderBrush="#1E2D45" BorderThickness="0,1,0,0"
                    IsVisible="{Binding IsEditing}" Padding="40,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="{infra:L save_note}" Classes="Success"
                            Padding="24,10"
                            Command="{Binding SaveNoteCommand}"/>
                    <Button Content="{infra:L cancel}" Classes="Secondary"
                            Padding="24,10"
                            Command="{Binding CancelEditCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
