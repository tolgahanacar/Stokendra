<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stokendra.ViewModels"
             xmlns:infra="using:Stokendra.Infrastructure"
             x:Class="Stokendra.Views.DepartmentsView"
             Background="#0C0E14"
             x:DataType="vm:DepartmentsViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="40,32,40,40">
        
        <!-- Başlık -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">
            <TextBlock Text="{infra:L menu_departments}" FontSize="28" FontWeight="Bold" Foreground="#F1F5F9"/>
            <TextBlock Text="{infra:L departments_subtitle}" FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- Ekleme Alanı -->
        <Border Grid.Row="1" Background="#161B27" CornerRadius="12" Padding="20,16" 
                BorderBrush="#1E2D45" BorderThickness="1" Margin="0,0,0,24"
                IsVisible="{Binding CanEdit}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox Text="{Binding NewDepartmentName}" 
                         Watermark="{infra:L dept_name_placeholder}" 
                         Width="300"
                         VerticalAlignment="Center"/>
                <Button Content="{infra:L add_dept_btn}" 
                        Classes="Primary"
                        Command="{Binding AddCommand}"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Liste -->
        <Border Grid.Row="2" Background="#161B27" CornerRadius="12" Padding="2" 
                BorderBrush="#1E2D45" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#1E2D45" Padding="16,10" CornerRadius="10,10,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{infra:L dept_name_col}" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <TextBlock Grid.Column="1" Text="{infra:L actions}" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,20,0" IsVisible="{Binding CanEdit}"/>
                    </Grid>
                </Border>
                
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Departments}" 
                         SelectedItem="{Binding SelectedDepartment}"
                         Background="Transparent" 
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="*,Auto" Margin="4">
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="14"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button Content="{infra:L edit}" 
                                            Classes="Secondary" 
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            FontSize="12"/>
                                    <Button Content="{infra:L delete}" 
                                            Classes="Danger" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        
        <ProgressBar Grid.Row="2" IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsLoading}"/>

    </Grid>
</UserControl>
