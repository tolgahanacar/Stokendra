<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stokendra.ViewModels"
        xmlns:infra="using:Stokendra.Infrastructure"
        x:Class="Stokendra.Views.AddMovementView"
        Title="{Binding Title}"
        Width="450" Height="560"
        MinWidth="400" MinHeight="460"
        MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#161B27">

    <Design.DataContext>
        <vm:AddMovementViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="#1C222E" Padding="20,16,20,14">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding Title}"
                            FontSize="18" FontWeight="Bold" Foreground="#E8EEFF"/>
                <TextBlock Text="{infra:L new_movement}"
                            FontSize="12" Foreground="#5A6987"/>
            </StackPanel>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="20,14,20,16">

                <StackPanel Spacing="5">
                    <TextBlock Text="{infra:L stock_card_required}" FontSize="12" Foreground="#8A9BBF"/>
                    <ComboBox ItemsSource="{Binding AllCards}"
                               SelectedItem="{Binding SelectedCard}"
                               HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                        <TextBlock Text="{infra:L operation_type}" FontSize="12" Foreground="#8A9BBF"/>
                        <ComboBox SelectedIndex="{Binding SelectedTypeIndex}"
                                   HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{infra:L entry}"/>
                            <ComboBoxItem Content="{infra:L exit}"/>
                            <ComboBoxItem Content="{infra:L type_empty}"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                        <TextBlock Text="{infra:L quantity_required}" FontSize="12" Foreground="#8A9BBF"/>
                        <NumericUpDown Value="{Binding Quantity}"
                                       Minimum="0"
                                       FormatString="N2"
                                       HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="5">
                    <TextBlock Text="{infra:L department_required}" FontSize="12" Foreground="#8A9BBF"/>
                    <ComboBox ItemsSource="{Binding AllDepartments}"
                               SelectedItem="{Binding Department}"
                               HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="{infra:L delivered_to_label}" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding DeliveredTo}" Watermark="{infra:L select_user}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="{infra:L date_label}" FontSize="12" Foreground="#8A9BBF"/>
                    <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="{infra:L description_label}" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding Description}"
                              Watermark="{infra:L note_content_placeholder}"
                              Height="60"
                              AcceptsReturn="True"
                              TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#1C222E"
                Padding="20,14,20,14"
                BorderBrush="#252D3D"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="#FF453A"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           IsVisible="{Binding ErrorMessage,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="{infra:L cancel}"
                             Classes="Secondary"
                             Command="{Binding CancelCommand}"
                             Width="90" MinHeight="36"/>
                    <Button Content="{infra:L save}"
                             Classes="Primary"
                             Command="{Binding SaveCommand}"
                             IsEnabled="{Binding SelectedCard,
                                 Converter={x:Static ObjectConverters.IsNotNull}}"
                             Width="90" MinHeight="36"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
