<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stokendra.ViewModels"
        x:Class="Stokendra.Views.AddServiceWindow"
        Title="{Binding Title}"
        Width="480" Height="580"
        MinWidth="420" MinHeight="460"
        MaxHeight="800"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#161B27">

    <Design.DataContext>
        <vm:AddServiceViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="#1C222E" Padding="20,16,20,14">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding Title}"
                           FontSize="18" FontWeight="Bold" Foreground="#E8EEFF"/>
                <TextBlock Text="Bakım ve onarım detayları"
                           FontSize="12" Foreground="#5A6987"/>
            </StackPanel>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="20,14,20,16">

                <StackPanel Spacing="5">
                    <TextBlock Text="Cihaz Adı" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding DeviceName}" Watermark="Cihaz modelini yazınız..."/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                        <TextBlock Text="Seri Numarası" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding SerialNumber}" Watermark="S/N..."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                        <TextBlock Text="Firma" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding Company}" Watermark="Servis firması..."/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="5">
                    <TextBlock Text="Bakım Tarihi" FontSize="12" Foreground="#8A9BBF"/>
                    <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Sorun / Talep" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding Issue}"
                             Watermark="Sorunu detaylandırın..."
                             Height="75" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Yapılan İşlem / Sonuç" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding ResultText}"
                             Watermark="Sonucu yazınız..."
                             Height="75" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer — always visible -->
        <Border Grid.Row="2"
                Background="#1C222E"
                Padding="20,14,20,14"
                BorderBrush="#252D3D"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="İptal"  Classes="Secondary" Command="{Binding CancelCommand}" Width="90" MinHeight="36"/>
                <Button Content="Kaydet" Classes="Primary"   Command="{Binding SaveCommand}"   Width="90" MinHeight="36"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
