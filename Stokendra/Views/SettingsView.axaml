<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stokendra.ViewModels"
             x:Class="Stokendra.Views.SettingsView"
             Background="#0C0E14">

    <ScrollViewer>
        <StackPanel Margin="28,24,28,24" Spacing="24">
            
            <!-- Başlık -->
            <StackPanel Spacing="4">
                <TextBlock Text="Ayarlar" FontSize="26" FontWeight="Bold" Foreground="#E8EEFF"/>
                <TextBlock Text="Uygulama tercihlerini yönetin ve veri güvenliğini sağlayın" FontSize="13" Foreground="#5A6987"/>
            </StackPanel>

            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                
                <!-- Genel Ayarlar -->
                <Border Classes="Card" Width="400" Margin="0,0,20,20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="⚙ Genel Yapılandırma" FontSize="15" FontWeight="Bold" Foreground="#38AEFF"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Firma / Kuruluş Adı" FontSize="12" Foreground="#8A9BBF"/>
                            <TextBox Text="{Binding CompanyName}" Watermark="Firma adı (raporlarda görünür)"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="6">
                            <TextBlock Text="Otomatik Yedekleme Klasörü" FontSize="12" Foreground="#8A9BBF"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding AutoBackupPath}" Watermark="Boş ise devre dışıdır" IsReadOnly="True" FontSize="11"/>
                                <Button Grid.Column="1" Content="..." Command="{Binding SelectBackupFolderCommand}" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Veritabanı Yolu" FontSize="12" Foreground="#8A9BBF"/>
                            <TextBox Text="{Binding DbPath}" IsReadOnly="True" Foreground="#5A6987" FontSize="11"/>
                        </StackPanel>
                        <Button Content="✔ Ayarları Kaydet" Classes="Primary"
                                Command="{Binding SaveSettingsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Şifre Değiştir -->
                <Border Classes="Card" Width="400" Margin="0,0,20,20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🔐 Güvenlik ve Şifre" FontSize="15" FontWeight="Bold" Foreground="#E67E22"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Mevcut Şifre" FontSize="12" Foreground="#8A9BBF"/>
                            <TextBox Text="{Binding OldPassword}" PasswordChar="●" Watermark="Mevcut şifreniz"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Yeni Şifre" FontSize="12" Foreground="#8A9BBF"/>
                            <TextBox Text="{Binding NewPassword}" PasswordChar="●" Watermark="En az 4 karakter"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Yeni Şifre (Tekrar)" FontSize="12" Foreground="#8A9BBF"/>
                            <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="Şifreyi tekrar girin"/>
                        </StackPanel>
                        <Button Content="Şifreyi Güncelle" Classes="Success"
                                Command="{Binding ChangePasswordAsyncCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Yedekleme ve Bakım -->
                <Border Classes="Card" Width="400" Margin="0,0,20,20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="💾 Veri Yedekleme" FontSize="15" FontWeight="Bold" Foreground="#2ECC71"/>
                        
                        <StackPanel Spacing="10">
                            <TextBlock Text="Veritabanı Yedeği (.db)" FontSize="13" FontWeight="SemiBold" Foreground="#D0D8F0"/>
                            <TextBlock Text="Veritabanı dosyasının birebir kopyasını alır. En güvenli yedekleme yöntemidir." 
                                       FontSize="11" Foreground="#8A9BBF" TextWrapping="Wrap"/>
                            <Button Content="📁 Veritabanı Yedeği Al" Classes="Primary"
                                    Command="{Binding DatabaseBackupCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <Separator Height="1" Background="#1E2D45" Margin="0,10"/>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Excel Rapor Yedeği (.xlsx)" FontSize="13" FontWeight="SemiBold" Foreground="#D0D8F0"/>
                            <TextBlock Text="Tüm verileri okunabilir Excel sayfalarına döker." 
                                       FontSize="11" Foreground="#8A9BBF" TextWrapping="Wrap"/>
                            <Button Content="📊 Excel Olarak Yedekle" Classes="Secondary"
                                    Command="{Binding FullBackupCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hakkında ve Sistem -->
                <Border Classes="Card" Width="400" Margin="0,0,20,20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="ℹ Sistem Bilgisi" FontSize="15" FontWeight="Bold" Foreground="#38AEFF"/>
                        
                        <!-- Bakım Kısmı -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Bakım ve Temizlik" FontSize="13" FontWeight="SemiBold" Foreground="#FF5B5B"/>
                            <TextBlock Text="İşlem geçmişini (Audit Log) temizlemek veritabanını küçültür." FontSize="11" Foreground="#8A9BBF" TextWrapping="Wrap"/>
                            <Button Content="🗑 İşlem Geçmişini Temizle" 
                                    Background="#2D1A1A" Foreground="#FF5B5B" BorderBrush="#4D2A2A" BorderThickness="1"
                                    Cursor="Hand"
                                    Command="{Binding TruncateAuditLogCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <Separator Height="1" Background="#1E2D45" Margin="0,10"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Stokendra" FontSize="22" FontWeight="Bold" Foreground="#38AEFF"/>
                            <TextBlock Text="{Binding AppVersion}" FontSize="13" Foreground="#5A6987"/>
                        </StackPanel>
                        <TextBlock Text="Modern Stok ve Servis Takip Çözümü" FontSize="12" Foreground="#8A9BBF"/>
                        <Separator Height="1" Background="#1E2D45"/>
                        <TextBlock Text="© 2026 Tolgahan Acar. Tüm hakları saklıdır." FontSize="11" Foreground="#3A4560"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Durum mesajı (Alt kısımda sabit) -->
            <Border Background="#161B27" CornerRadius="8" Padding="16,12" BorderBrush="#1E2D45" BorderThickness="1"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    HorizontalAlignment="Left" MinWidth="400">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="ℹ" Foreground="#38AEFF" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="#D0D8F0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
