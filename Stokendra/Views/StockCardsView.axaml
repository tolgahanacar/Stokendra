<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stokendra.ViewModels"
             xmlns:infra="using:Stokendra.Infrastructure"
             x:Class="Stokendra.Views.StockCardsView"
             Background="#0C0E14"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="40,32,40,0" Spacing="6">
            <TextBlock Text="{infra:L stock_cards}" FontSize="30" FontWeight="Black" Foreground="#F8FAFC"/>
            <TextBlock Text="{infra:L stock_cards_subtitle}" FontSize="13" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- Search -->
        <Border Grid.Row="1" Background="#161B27" Margin="28,16,28,0" CornerRadius="10" Padding="16,12">
            <WrapPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchText}"
                          Watermark="{infra:L search_placeholder}"
                          Width="280" Margin="0,0,10,4"/>
                <Button Content="{infra:L clear_filter}" Classes="Secondary"
                        Command="{Binding ClearSearchCommand}"
                        Margin="0,0,0,4"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="28,12,28,0">
            <Button Content="{infra:L new_card}" Classes="Primary"
                    Command="{Binding AddCardCommand}"
                    IsVisible="{Binding CanEdit}"
                    Margin="0,0,8,6"/>
            
            <Button Content="{infra:L edit}" Classes="Secondary"
                    Command="{Binding EditCardCommand}"
                    IsEnabled="{Binding IsSingleCardSelected}"
                    IsVisible="{Binding CanEdit}"
                    Margin="0,0,8,6"/>
            
            <Button Content="{infra:L delete}" Classes="Danger"
                    Command="{Binding DeleteCardCommand}"
                    IsEnabled="{Binding IsCardSelected}"
                    IsVisible="{Binding CanEdit}"
                    Margin="0,0,8,6"/>

            <Rectangle Width="1" Height="24" Fill="#30384C" Margin="0,0,8,6" VerticalAlignment="Center" IsVisible="{Binding CanEdit}"/>

            <Button Content="{infra:L detail}" Classes="Success"
                    Command="{Binding ShowDetailCommand}"
                    IsEnabled="{Binding IsSingleCardSelected}"
                    Margin="0,0,8,6"/>

            <Rectangle Width="1" Height="24" Fill="#30384C" Margin="0,0,8,6" VerticalAlignment="Center"/>

            <Button Content="{infra:L export_excel}" Classes="Secondary"
                    Command="{Binding ExportExcelCommand}"
                    Margin="0,0,8,6"/>
            
            <Button Content="{infra:L print}" Classes="Success"
                    Command="{Binding PrintCommand}"
                    Margin="0,0,8,6"/>

            <Button Content="{infra:L import_excel}" Classes="Secondary"
                    Command="{Binding ImportExcelCommand}"
                    IsVisible="{Binding CanEdit}"
                    Margin="0,0,0,6"/>
            
        </WrapPanel>

        <!-- Grid -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="CardsGrid"
                      Margin="28,12,28,16"
                      ItemsSource="{Binding Cards}"
                      SelectedItem="{Binding SelectedCard}"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      CanUserResizeColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      DoubleTapped="CardsGrid_DoubleTapped"
                      SelectionChanged="CardsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{infra:L code_no}"       Binding="{Binding Code}"        Width="80"  MinWidth="60"/>
                    <DataGridTextColumn Header="{infra:L stock_name}"    Binding="{Binding Name}"        Width="2*"  MinWidth="120"/>
                    <DataGridTextColumn Header="{infra:L card_type}"     Binding="{Binding CardTypeDisplay}" Width="95" MinWidth="75"/>
                    <DataGridTextColumn Header="{infra:L parent_card}"   Binding="{Binding ParentName}"  Width="*"   MinWidth="120"/>
                    <DataGridTextColumn Header="{infra:L category}"      Binding="{Binding Category}"    Width="*"   MinWidth="80"/>
                    <DataGridTextColumn Header="{infra:L current_stock}" Binding="{Binding CurrentStock}" Width="95" MinWidth="75"/>
                    <DataGridTextColumn Header="{infra:L min_stock}"     Binding="{Binding MinStock}"     Width="95" MinWidth="75"/>
                    <DataGridTextColumn Header="{infra:L unit}"          Binding="{Binding Unit}"         Width="85" MinWidth="65"/>
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsLoading}"/>
            <Border IsVisible="{Binding !IsLoading}" IsHitTestVisible="False">
                <TextBlock Text="{infra:L no_records_found}"
                           IsVisible="{Binding Cards.Count, Converter={StaticResource ZeroToBoolConverter}}"
                           Foreground="#64748B" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="20"/>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4" Background="#161B27" Padding="28,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" Foreground="#5A6987" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="◀" Command="{Binding PrevPageCommand}" Classes="Secondary" Padding="8,2"/>
                    <TextBlock Text="{Binding CurrentPage}" Foreground="#F1F5F9" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="/" Foreground="#5A6987" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPages}" Foreground="#5A6987" VerticalAlignment="Center"/>
                    <Button Content="▶" Command="{Binding NextPageCommand}" Classes="Secondary" Padding="8,2"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
