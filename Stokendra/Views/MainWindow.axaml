<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stokendra.ViewModels"
        xmlns:infra="using:Stokendra.Infrastructure"
        x:Class="Stokendra.Views.MainWindow"
        Title="Stokendra"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0C0E14"
        Icon="/Stokendra.ico"
        x:CompileBindings="False">

    <Grid ColumnDefinitions="250,*">

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20,20,20,12">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="STOKENDRA"
                                       FontSize="20" FontWeight="Black"
                                       Foreground="#3B82F6"
                                       LetterSpacing="1"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#60A5FA"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{infra:L app_management_panel}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- ═══ MENÜ (Kaydırılabilir) ═══ -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,4,10,10" Spacing="2">

                        <TextBlock Text="{infra:L menu}" FontSize="9" FontWeight="Bold"
                                   Foreground="#3A4560" LetterSpacing="2"
                                   Margin="16,0,0,6"/>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=dashboard}"
                                Command="{Binding NavigateToDashboardCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L dashboard}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=reports}"
                                Command="{Binding NavigateToReportsCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="📈" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L reports}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=stockcards}"
                                Command="{Binding NavigateToStockCardsCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="📇" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L stock_cards}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=movements}"
                                Command="{Binding NavigateToMovementsCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="🔄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L stock_movements}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=stocks}"
                                Command="{Binding NavigateToStocksCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L stocks}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=services}"
                                Command="{Binding NavigateToServicesCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="🛠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L services}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=departments}"
                                Command="{Binding NavigateToDepartmentsCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="🏢" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L departments}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=notes}"
                                Command="{Binding NavigateToNotesCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="📝" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L notes}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <!-- Ayırıcı -->
                        <Border Height="1" Background="#1A2035" Margin="8,6"/>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=guide}"
                                Command="{Binding NavigateToGuideCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="📖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L menu_guide}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=users}"
                                Command="{Binding NavigateToUsersCommand}"
                                IsVisible="{Binding IsAdmin}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L menu_users}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                        <Button Classes="MenuButton"
                                Classes.Active="{Binding ActiveMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=settings}"
                                Command="{Binding NavigateToSettingsCommand}">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="⚙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{infra:L settings}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ KULLANICI PANELİ & ÇIKIŞ ═══ -->
                <Border Grid.Row="2" Padding="10,8" BorderBrush="#1A2035" BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="Auto,Auto">

                        <!-- Kullanıcı Bilgi + Çıkış Tek Satır -->
                        <Border Grid.Row="0" Background="#141B2D" CornerRadius="8" Padding="10,8">
                            <Grid ColumnDefinitions="32,*,Auto">
                                <!-- Avatar -->
                                <Border Grid.Column="0"
                                        Width="30" Height="30"
                                        CornerRadius="15"
                                        Background="#1E3A5F">
                                    <TextBlock Text="👤" FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Ad & Rol -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CurrentUser}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#CBD5E1"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Background="{Binding CurrentRole, Converter={StaticResource RoleBackgroundConverter}}"
                                            CornerRadius="3" Padding="5,1"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CurrentRole}"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Çıkış Butonu (kompakt simge) -->
                                <Button Grid.Column="2"
                                        Command="{Binding LogoutCommand}"
                                        ToolTip.Tip="{infra:L logout_tooltip}"
                                        Width="32" Height="32"
                                        Padding="0"
                                        CornerRadius="6"
                                        Background="#1C1F2E"
                                        Foreground="#EF4444"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Cursor="Hand">
                                    <TextBlock Text="🚪" FontSize="14"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Copyright -->
                        <TextBlock Grid.Row="1"
                                   Text="{infra:L app_copyright}"
                                   FontSize="8" Foreground="#2A3550"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ═══ İÇERİK + GÜNCELLEME BANNER ═══ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- ── Güncelleme Banner'ı ── -->
            <Border Grid.Row="0"
                    IsVisible="{Binding HasUpdate}"
                    Background="#0D2847"
                    BorderBrush="#1E4D8C"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Sol: İkon + Mesaj -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="#1A3F6F" CornerRadius="16" Width="32" Height="32">
                            <TextBlock Text="🚀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Orta: Metin + Progress -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="10,0">

                        <!-- Güncelleme mesajı (indirme başlamadıysa) -->
                        <TextBlock Text="{Binding UpdateMessage}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#C8DEFF"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !IsDownloading}"/>

                        <!-- İndirme durumu (indirme başladıysa) -->
                        <StackPanel IsVisible="{Binding IsDownloading}" Spacing="4">
                            <TextBlock Text="{Binding DownloadStatusText}"
                                       FontSize="12" Foreground="#A0C4FF"/>
                            <ProgressBar Value="{Binding DownloadProgress}"
                                         Minimum="0" Maximum="100"
                                         Height="6"
                                         Foreground="#3B82F6"
                                         Background="#1A2D50"
                                         CornerRadius="3"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sağ: Aksiyonlar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                        <!-- İndirme başlamadıysa: "İndir ve Kur" + "Sonra" butonları -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding !IsDownloading}">

                            <!-- Release notlarını görmek için -->
                            <Button Content="{infra:L update_release_notes}"
                                    Command="{Binding OpenReleasePageCommand}"
                                    FontSize="11" Padding="10,5"
                                    Background="#1A3F6F" Foreground="#A0C4FF"
                                    BorderBrush="#2A5F9F" BorderThickness="1"
                                    CornerRadius="4" Cursor="Hand"/>

                            <!-- İndir ve Kur -->
                            <Button Content="{infra:L update_download_install}"
                                    Command="{Binding DownloadAndInstallUpdateCommand}"
                                    FontSize="11" FontWeight="Bold" Padding="14,5"
                                    Background="#2563EB" Foreground="White"
                                    CornerRadius="4" Cursor="Hand"/>

                            <!-- Kapat (X) -->
                            <Button Content="✕"
                                    Command="{Binding DismissUpdateCommand}"
                                    FontSize="12" Padding="6,4"
                                    Background="Transparent" Foreground="#5A7EB5"
                                    CornerRadius="4" Cursor="Hand"
                                    ToolTip.Tip="{infra:L update_dismiss_tooltip}"/>
                        </StackPanel>

                        <!-- İndirme sırasında: İptal butonu -->
                        <Button Content="{infra:L update_cancel_download}"
                                Command="{Binding CancelDownloadCommand}"
                                IsVisible="{Binding IsDownloading}"
                                FontSize="11" Padding="10,5"
                                Background="#3D1A1A" Foreground="#FF7B7B"
                                BorderBrush="#5C2A2A" BorderThickness="1"
                                CornerRadius="4" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Sayfa İçeriği ── -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"/>
        </Grid>

    </Grid>
</Window>
