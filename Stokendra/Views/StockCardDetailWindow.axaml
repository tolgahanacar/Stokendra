<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stokendra.ViewModels"
        xmlns:infra="using:Stokendra.Infrastructure"
        x:Class="Stokendra.Views.StockCardDetailWindow"
        Title="{infra:L stock_card_detail}"
        Width="1000" Height="720"
        MinWidth="800" MinHeight="520"
        MaxHeight="960"
        WindowStartupLocation="CenterOwner"
        Background="#0C0E14" x:CompileBindings="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="#1C222E" Padding="24,16,24,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Card.Name}"
                               FontSize="22" FontWeight="Black" Foreground="#F8FAFC"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding Card.Code}"
                                   Foreground="#3B82F6" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Card.Category}"
                                   Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding Card.ParentName, StringFormat='Parent Card: {0}'}"
                                   Foreground="#64748B"
                                   IsVisible="{Binding Card.ParentName,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             Spacing="2">
                    <TextBlock Text="{infra:L current_stock_label}"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#64748B"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Card.CurrentStock, StringFormat='{}{0}'}"
                               FontSize="28" FontWeight="Black"
                               Foreground="#10B981"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,14,24,0">
            <Border Grid.Column="0"
                    Background="#161B27"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,14,0"
                    BorderBrush="#1E2D45"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="{infra:L description_label}"
                               FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    <TextBlock Text="{Binding Card.Description}"
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap"
                               MaxHeight="48"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Background="#161B27"
                    CornerRadius="10"
                    Padding="16"
                    Width="280"
                    BorderBrush="#1E2D45"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="{infra:L movement_summary}"
                               FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{infra:L entry}"
                                       FontSize="10" Foreground="#10B981" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalEntryLast30}"
                                       FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{infra:L exit}"
                                       FontSize="10" Foreground="#EF4444" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalExitLast30}"
                                       FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Movement List -->
        <Grid Grid.Row="2" Margin="24,14,24,14">
            <Border Background="#161B27"
                    CornerRadius="10"
                    BorderBrush="#1E2D45"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="#1E2D45"
                            Padding="16,10"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="{infra:L movement_history}"
                                   FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                    <DataGrid Grid.Row="1"
                               ItemsSource="{Binding Movements}"
                               IsReadOnly="True"
                               Background="Transparent"
                               BorderThickness="0"
                               CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{infra:L date}"
                                                Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}"
                                                Width="150"/>
                            <DataGridTemplateColumn Header="{infra:L type}" Width="80">
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayType}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{infra:L quantity}"    Binding="{Binding Quantity}"  Width="80"/>
                            <DataGridTextColumn Header="{infra:L department}"  Binding="{Binding Department}" Width="150"/>
                            <DataGridTextColumn Header="{infra:L delivered_to}" Binding="{Binding Recipient}"  Width="150"/>
                            <DataGridTextColumn Header="{infra:L description}"  Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <!-- Loading overlay -->
            <ProgressBar IsIndeterminate="True"
                          VerticalAlignment="Top"
                          IsVisible="{Binding IsLoading}"/>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="#1C222E"
                Padding="24,14"
                BorderBrush="#1E2D45"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Button Content="{infra:L add_movement}"
                             Classes="Success"
                             Command="{Binding AddMovementCommand}"
                             MinHeight="36"/>
                    <Button Content="{infra:L print}"
                             Classes="Success"
                             Command="{Binding PrintCommand}"
                             MinHeight="36"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{infra:L close}"
                        Classes="Secondary"
                        Command="{Binding CloseCommand}"
                        HorizontalAlignment="Right"
                        Width="90" MinHeight="36"/>
            </Grid>
        </Border>

    </Grid>
</Window>
