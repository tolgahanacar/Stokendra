<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stokendra.ViewModels"
             xmlns:infra="using:Stokendra.Infrastructure"
             xmlns:models="using:Stokendra.Models"
             x:Class="Stokendra.Views.UsersView"
             Background="#0C0E14"
             x:DataType="vm:UsersViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="28,24,28,24">
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="{infra:L users_title}" FontSize="26" FontWeight="Bold" Foreground="#E8EEFF"/>
            <TextBlock Text="{infra:L users_subtitle}" FontSize="13" Foreground="#5A6987"/>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnDefinitions="350,*">
            
            <!-- Left: Add User Form -->
            <Border Grid.Column="0" Classes="Card" VerticalAlignment="Top" Margin="0,0,20,0">
                <StackPanel Spacing="16">
                    <TextBlock Text="{infra:L add_user_header}" FontSize="16" FontWeight="Bold" Foreground="#38AEFF"/>
                    
                    <StackPanel Spacing="6">
                        <TextBlock Text="{infra:L username}" FontSize="12" Foreground="#8A9BBF" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewUsername}" Watermark="{infra:L username}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{infra:L password}" FontSize="12" Foreground="#8A9BBF" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewPassword}" PasswordChar="●" Watermark="{infra:L password_policy_hint}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{infra:L role}" FontSize="12" Foreground="#8A9BBF" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Button Content="{infra:L add_user_btn}" Classes="Primary"
                            Command="{Binding AddUserCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="40" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Right: Users List -->
            <Border Grid.Column="1" Classes="Card" Padding="20">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{infra:L users_list_header}" FontSize="16" FontWeight="Bold" Foreground="#E8EEFF" Margin="0,0,0,16"/>
                    
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding Users}"
                                 SelectedItem="{Binding SelectedUser}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.UserCard">
                                    <Setter Property="BorderBrush" Value="#38AEFF"/>
                                    <Setter Property="Background" Value="#1A2235"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover Border.UserCard">
                                    <Setter Property="BorderBrush" Value="#2A3C5A"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:User" x:CompileBindings="False">
                                    <Border Classes="UserCard"
                                            Padding="16,14" CornerRadius="10"
                                            Background="#161B27"
                                            BorderBrush="#1E2D45" BorderThickness="1">
                                        <Border.Transitions>
                                            <Transitions>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            
                                            <!-- Avatar Circle -->
                                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" 
                                                    BorderThickness="1.5"
                                                    BorderBrush="{Binding Role, Converter={StaticResource RoleColorConverter}}"
                                                    Background="{Binding Role, Converter={StaticResource RoleBackgroundConverter}}">
                                                <TextBlock Text="{Binding Username, Converter={StaticResource FirstLetterConverter}}"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Role, Converter={StaticResource RoleColorConverter}}"/>
                                            </Border>
                                            
                                            <!-- User Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="4">
                                                <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding Role, Converter={StaticResource RoleColorConverter}}"
                                                        Background="{Binding Role, Converter={StaticResource RoleBackgroundConverter}}">
                                                    <TextBlock Text="{Binding Role, Converter={StaticResource RoleTextConverter}}" 
                                                               FontSize="10" FontWeight="SemiBold" 
                                                               Foreground="{Binding Role, Converter={StaticResource RoleColorConverter}}"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <!-- Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="{infra:L change_password}" Classes="Primary"
                                                        Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="12,6" FontSize="11" CornerRadius="6"/>
                                                <Button Content="{infra:L toggle_role_btn}" Classes="Secondary"
                                                        Command="{Binding DataContext.ChangeRoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding CanEdit}"
                                                        Padding="12,6" FontSize="11" CornerRadius="6"/>
                                                <Button Content="{infra:L delete}" Classes="Danger"
                                                        Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding CanEdit}"
                                                        Padding="12,6" FontSize="11" CornerRadius="6"/>
                                            </StackPanel>
                                            
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- Status Bar Alert -->
        <Border Grid.Row="2" Background="#161B27" CornerRadius="8" Padding="16,12" BorderBrush="#1E2D45" BorderThickness="1"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                HorizontalAlignment="Left" MinWidth="400" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="ℹ" Foreground="#38AEFF" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#D0D8F0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
