<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StokTakip.ViewModels"
             xmlns:models="using:StokTakip.Models"
             x:Class="StokTakip.Views.StocksView"
             x:DataType="vm:StocksViewModel"
             Background="#0C0E14">

    <Design.DataContext>
        <vm:StocksViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="40,40,40,0" Spacing="8">
            <TextBlock Text="Stok Durumu" FontSize="32" FontWeight="Black" Foreground="#F8FAFC"/>
            <TextBlock Text="Güncel envanter ve miktar bilgileri" FontSize="14" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- Arama ve Filtre -->
        <Border Grid.Row="1" Background="#161B27" Margin="28,16,28,0" CornerRadius="10" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox Text="{Binding SearchText}"
                         Watermark="🔍 Ürün kodu veya adı ile ara..."
                         Width="350"/>
                <Button Content="Temizle" Classes="Secondary" Command="{Binding ClearSearchCommand}"/>
                <Button Content="↺ Yenile" Classes="Secondary" Command="{Binding RefreshCommand}"/>
                <Button Content="⎙ Yazdır" Classes="Success" Command="{Binding PrintCommand}"/>
                <Button Content="📊 Excel" Classes="Secondary" Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <DataGrid Grid.Row="2"
                  Margin="40,24,40,24"
                  ItemsSource="{Binding Stocks}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod"       Binding="{Binding KodNo}"      Width="100"/>
                <DataGridTextColumn Header="Stok Adı"  Binding="{Binding Ad}"         Width="250"/>
                <DataGridTextColumn Header="Kategori"  Binding="{Binding Kategori}"   Width="150"/>
                <DataGridTemplateColumn Header="Durum" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:StokKarti">
                            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" Margin="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusLabel}"
                                           Foreground="#FFFFFF"
                                           FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Giriş (Y)" Binding="{Binding ToplamGiris}" Width="100"/>
                <DataGridTextColumn Header="Çıkış (G)" Binding="{Binding ToplamCikis}" Width="100"/>
                <DataGridTextColumn Header="Sonuç"    Binding="{Binding MevcutStok}" Width="100"/>
                <DataGridTextColumn Header="Min"       Binding="{Binding MinStok}"    Width="100"/>
                <DataGridTextColumn Header="Birim"     Binding="{Binding Birim}"      Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Alt bilgi -->
        <Border Grid.Row="3" Background="#161B27" Padding="28,8">
            <TextBlock Text="{Binding StatusText}" Foreground="#5A6987" FontSize="12"/>
        </Border>

    </Grid>
</UserControl>
