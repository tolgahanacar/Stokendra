<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StokTakip.ViewModels"
             x:Class="StokTakip.Views.NotesView"
             Background="#0C0E14">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Delete" 
                    Command="{Binding DeleteSelectedCommand}" 
                    CommandParameter="{Binding #NotesGrid.SelectedItems}"/>
    </UserControl.KeyBindings>

    <Grid ColumnDefinitions="350,*">

        <!-- Sol: Not listesi -->
        <Border Grid.Column="0" Background="#0E1119" BorderBrush="#1E2535" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Başlık ve Durum -->
                <StackPanel Grid.Row="0" Margin="24,32,24,0" Spacing="4">
                    <TextBlock Text="Notlarım" FontSize="26" FontWeight="Bold" Foreground="#E8EEFF"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#64748B"/>
                </StackPanel>

                <!-- Aksiyon Butonları -->
                <StackPanel Grid.Row="1" Margin="24,20,24,12" Spacing="8">
                    <Button Content="＋ Yeni Not Oluştur" Classes="Primary"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="40"
                            Command="{Binding NewNoteCommand}"/>
                    
                    <UniformGrid Columns="2">
                        <Button Content="✎ Düzenle" Classes="Secondary" Margin="0,0,4,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding EditNoteCommand}"
                                IsEnabled="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="🗑 Sil" Classes="Danger" Margin="4,0,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Silmek için 'Delete' tuşunu kullanabilirsiniz"
                                Command="{Binding DeleteSelectedCommand}"
                                CommandParameter="{Binding #NotesGrid.SelectedItems}"
                                IsEnabled="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </UniformGrid>
                </StackPanel>

                <!-- Liste -->
                <ListBox Grid.Row="2"
                         Name="NotesGrid"
                         Margin="12,0"
                         ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote}"
                         SelectionMode="Multiple, Toggle"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected Border.NoteCard">
                            <Setter Property="BorderBrush" Value="#38AEFF"/>
                            <Setter Property="Background" Value="#1A2235"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border.NoteCard">
                            <Setter Property="BorderBrush" Value="#2A3C5A"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="NoteCard" 
                                    Padding="16,14" CornerRadius="10" 
                                    Background="#161B27"
                                    BorderBrush="#1E2D45" BorderThickness="1">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Grid.Column="0" 
                                              Margin="0,0,16,0" 
                                              IsChecked="{Binding $parent[ListBoxItem].IsSelected, Mode=OneWay}"
                                              IsHitTestVisible="False" 
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{Binding Baslik}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="#F1F5F9"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="🕒" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                                            <TextBlock Text="{Binding OlusturmaTarihi, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                       FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Sağ: Detay / Düzenleme -->
        <Grid Grid.Column="1" Background="#0C0E14" RowDefinitions="*,Auto">
            
            <!-- Görüntüleme -->
            <ScrollViewer Grid.Row="0" IsVisible="{Binding !IsEditing}">
                <StackPanel Margin="40,32" Spacing="20"
                            IsVisible="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SelectedNote.Baslik}"
                                   FontSize="28" FontWeight="ExtraBold" Foreground="#F1F5F9"
                                   TextWrapping="Wrap"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="16" Opacity="0.7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📅 Oluşturma:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SelectedNote.OlusturmaTarihi, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                           FontSize="12" Foreground="#38AEFF" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📝 Güncelleme:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SelectedNote.GuncellenmeTarihi, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                           FontSize="12" Foreground="#38AEFF" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#1E2D45"/>

                    <TextBlock Text="{Binding SelectedNote.Icerik}"
                               FontSize="16" Foreground="#CBD5E1"
                               TextWrapping="Wrap" LineHeight="26"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Düzenleme -->
            <ScrollViewer Grid.Row="0" IsVisible="{Binding IsEditing}">
                <StackPanel Margin="40,32" Spacing="20">
                    <TextBlock Text="Notu Düzenle" FontSize="20" FontWeight="Bold" Foreground="#38AEFF"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Başlık" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding EditTitle}" 
                                 Watermark="Not başlığını girin..."
                                 FontSize="15" Padding="12"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="İçerik" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding EditContent}"
                                 Watermark="Not içeriği..."
                                 AcceptsReturn="True"
                                 MinHeight="400"
                                 FontSize="15" Padding="12"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Alt Butonlar -->
            <Border Grid.Row="1" Background="#0E1119" BorderBrush="#1E2D45" BorderThickness="0,1,0,0"
                    IsVisible="{Binding IsEditing}" Padding="40,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="💾 Değişiklikleri Kaydet" Classes="Success"
                            Padding="24,10"
                            Command="{Binding SaveNoteCommand}"/>
                    <Button Content="İptal" Classes="Secondary"
                            Padding="24,10"
                            Command="{Binding CancelEditCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
