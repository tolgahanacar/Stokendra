<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StokTakip.ViewModels"
             x:Class="StokTakip.Views.StockCardsView"
             Background="#0C0E14">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="40,40,40,0" Spacing="8">
            <TextBlock Text="Stok Kartları" FontSize="32" FontWeight="Black" Foreground="#F8FAFC"/>
            <TextBlock Text="Sistemde kayıtlı tüm sarf malzemelerini buradan yönetin" FontSize="14" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- Arama -->
        <Border Grid.Row="1" Background="#161B27" Margin="28,16,28,0" CornerRadius="10" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox Text="{Binding SearchText}"
                         Watermark="🔍 Kod, ad veya kategori ara..."
                         Width="320"/>
                <Button Content="Temizle" Classes="Secondary"
                        Command="{Binding ClearSearchCommand}"/>
                <Button Content="↺ Yenile" Classes="Secondary"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="28,12,28,0">
            <Button Content="＋ Ekle" Classes="Primary"
                    Command="{Binding AddCardCommand}"/>
            
            <Button Content="✎ Düzenle" Classes="Secondary"
                    Command="{Binding EditCardCommand}"
                    IsEnabled="{Binding IsCardSelected}"/>
            
            <Button Content="🗑 Sil" Classes="Danger"
                    Command="{Binding DeleteCardCommand}"
                    IsEnabled="{Binding IsCardSelected}"/>

            <Button Content="🗑 Toplu Sil" Classes="Danger"
                    Command="{Binding BulkDeleteCommand}"
                    IsEnabled="{Binding IsMultipleSelected}"/>

            <Rectangle Width="1" Height="24" Fill="#30384C" Margin="4,0"/>

            <Button Content="🔍 Detay" Classes="Success"
                    Command="{Binding ShowDetailCommand}"
                    IsEnabled="{Binding IsCardSelected}"/>
            
            <Button Content="📥 Toplu Giriş" Classes="Secondary"
                    Command="{Binding BulkEntryCommand}"/>

            <Rectangle Width="1" Height="24" Fill="#30384C" Margin="4,0"/>

            <Button Content="📊 Excel" Classes="Secondary"
                    Command="{Binding ExportExcelCommand}"/>
            
            <Button Content="📥 İçe Aktar" Classes="Secondary"
                    Command="{Binding ImportExcelCommand}"/>
            
            <Button Content="📄 Örnek" Classes="Secondary"
                    Command="{Binding DownloadSampleCommand}"/>
        </StackPanel>

        <!-- Grid -->
        <DataGrid Grid.Row="3"
                  x:Name="CardsGrid"
                  Margin="40,24,40,24"
                  ItemsSource="{Binding Cards}"
                  SelectedItem="{Binding SelectedCard}"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  CanUserResizeColumns="True"
                  SelectionChanged="CardsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod"       Binding="{Binding KodNo}"      Width="100"/>
                <DataGridTextColumn Header="Ad"        Binding="{Binding Ad}"          Width="300"/>
                <DataGridTextColumn Header="Tip"       Binding="{Binding KartTipi}"    Width="100"/>
                <DataGridTextColumn Header="Üst Kart"  Binding="{Binding UstKartAd}"   Width="300"/>
                <DataGridTextColumn Header="Kategori"  Binding="{Binding Kategori}"    Width="200"/>
                <DataGridTextColumn Header="Mevcut"    Binding="{Binding MevcutStok}"  Width="100"/>
                <DataGridTextColumn Header="Min"       Binding="{Binding MinStok}"     Width="100"/>
                <DataGridTextColumn Header="Birim"     Binding="{Binding Birim}"       Width="150"/>
                <DataGridTextColumn Header="Konum"     Binding="{Binding Konum}"       Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <Border Grid.Row="4" Background="#161B27" Padding="28,8">
            <TextBlock Text="{Binding StatusText}" Foreground="#5A6987" FontSize="12"/>
        </Border>

    </Grid>
</UserControl>
