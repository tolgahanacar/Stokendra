<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StokTakip.ViewModels"
             x:Class="StokTakip.Views.DashboardView"
             Background="#0C0E14">

    <ScrollViewer>
        <StackPanel Margin="28,24,28,24" Spacing="24">

            <!-- Başlık -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="#E8EEFF"/>
                <TextBlock Text="Envanter durumuna genel bakış" FontSize="13" Foreground="#5A6987"/>
            </StackPanel>

            <!-- Yükleniyor -->
            <TextBlock Text="Yükleniyor..."
                       FontSize="14" Foreground="#5A6987"
                       IsVisible="{Binding IsLoading}"
                       HorizontalAlignment="Center"/>

            <!-- Stat Kartları -->
            <WrapPanel IsVisible="{Binding !IsLoading}">
                <Border Classes="StatCard" Width="180" Margin="0,0,12,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TOPLAM KART" FontSize="10" FontWeight="Bold" Foreground="#5A6987"/>
                        <TextBlock Text="{Binding TotalCards}" FontSize="32" FontWeight="Bold" Foreground="#38AEFF"/>
                        <TextBlock Text="Stok kartı" FontSize="11" Foreground="#3A4560"/>
                    </StackPanel>
                </Border>
                <Border Classes="StatCard" Width="180" Margin="0,0,12,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TOPLAM STOK" FontSize="10" FontWeight="Bold" Foreground="#5A6987"/>
                        <TextBlock Text="{Binding TotalStock}" FontSize="32" FontWeight="Bold" Foreground="#00DC82"/>
                        <TextBlock Text="Toplam miktar" FontSize="11" Foreground="#3A4560"/>
                    </StackPanel>
                </Border>
                <Border Classes="StatCard" Width="180" Margin="0,0,12,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="DÜŞÜK STOK" FontSize="10" FontWeight="Bold" Foreground="#5A6987"/>
                        <TextBlock Text="{Binding LowStock}" FontSize="32" FontWeight="Bold" Foreground="#F39C12"/>
                        <TextBlock Text="Kritik seviye" FontSize="11" Foreground="#3A4560"/>
                    </StackPanel>
                </Border>
                <Border Classes="StatCard" Width="180" Margin="0,0,12,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TÜKENMİŞ" FontSize="10" FontWeight="Bold" Foreground="#5A6987"/>
                        <TextBlock Text="{Binding DepletedStock}" FontSize="32" FontWeight="Bold" Foreground="#E74C3C"/>
                        <TextBlock Text="Sıfır stok" FontSize="11" Foreground="#3A4560"/>
                    </StackPanel>
                </Border>
                <Border Classes="StatCard" Width="180" Margin="0,0,12,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TOPLAM HAREKET" FontSize="10" FontWeight="Bold" Foreground="#5A6987"/>
                        <TextBlock Text="{Binding TotalMovements}" FontSize="32" FontWeight="Bold" Foreground="#9B59B6"/>
                        <TextBlock Text="Tüm kayıtlar" FontSize="11" Foreground="#3A4560"/>
                    </StackPanel>
                </Border>
                <Border Classes="StatCard" Width="180" Margin="0,0,0,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="BUGÜN" FontSize="10" FontWeight="Bold" Foreground="#5A6987"/>
                        <TextBlock Text="{Binding TodayMovements}" FontSize="32" FontWeight="Bold" Foreground="#E67E22"/>
                        <TextBlock Text="Bugünkü hareket" FontSize="11" Foreground="#3A4560"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Düşük Stok Uyarıları -->
            <Border Classes="Card" IsVisible="{Binding !IsLoading}">
                <StackPanel Spacing="14">
                    <TextBlock Text="⚠ Düşük Stok Uyarıları"
                               FontSize="15" FontWeight="Bold" Foreground="#F39C12"/>

                    <DataGrid ItemsSource="{Binding LowStockItems}"
                              Height="220"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              Background="#0C0E14"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod"      Binding="{Binding KodNo}"   Width="150"/>
                            <DataGridTextColumn Header="Stok Adı" Binding="{Binding Ad}"      Width="200"/>
                            <DataGridTextColumn Header="Mevcut"   Binding="{Binding Mevcut}"  Width="150"/>
                            <DataGridTextColumn Header="Min"      Binding="{Binding MinStok}" Width="150"/>
                            <DataGridTextColumn Header="Durum"    Binding="{Binding Durum}"   Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
