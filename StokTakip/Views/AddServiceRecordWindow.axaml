<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StokTakip.ViewModels"
        x:Class="StokTakip.Views.AddServiceRecordWindow"
        Title="{Binding Title}"
        Width="480" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#161B27"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Design.DataContext>
        <vm:AddServiceViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#1C222E" Padding="20,40,20,15">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#E8EEFF"/>
                <TextBlock Text="Bakım ve onarım detayları" FontSize="12" Foreground="#5A6987"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="16">
                
                <StackPanel Spacing="6">
                    <TextBlock Text="Cihaz Adı" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding DeviceName}" Watermark="Cihaz modelini yazınız..."/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                        <TextBlock Text="Seri Numarası" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding SerialNumber}" Watermark="S/N..."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                        <TextBlock Text="Firma" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding Company}" Watermark="Servis firması..."/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Bakım Tarihi" FontSize="12" Foreground="#8A9BBF"/>
                    <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Sorun / Talep" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding Issue}" 
                             Watermark="Sorunu detaylandırın..."
                             Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Yapılan İşlem / Sonuç" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding ResultText}" 
                             Watermark="Sonucu yazınız..."
                             Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1C222E" Padding="20" BorderBrush="#252D3D" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="İptal" Classes="Secondary" Command="{Binding CancelCommand}" Width="100"/>
                <Button Content="Kaydet" Classes="Primary" Command="{Binding SaveCommand}" Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
