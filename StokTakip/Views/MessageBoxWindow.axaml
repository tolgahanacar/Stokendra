<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StokTakip.Views.MessageBoxWindow"
        Title="Bilgi"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#161B27"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True">

    <Border BorderBrush="#1E2D45" BorderThickness="1" Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <TextBlock Grid.Row="0" Name="TitleText" Text="Bilgi" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,16"/>
            
            <!-- Message -->
            <TextBlock Grid.Row="1" Name="MessageText" Text="Mesaj içeriği..." Foreground="#F8FAFC" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,24"/>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Name="CancelBtn" Content="İptal" Classes="Secondary" Width="100" IsVisible="False"/>
                <Button Name="OkBtn" Content="Tamam" Classes="Primary" Width="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
