<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StokTakip.ViewModels"
             xmlns:models="using:StokTakip.Models"
             x:Class="StokTakip.Views.StockMovementsView"
             x:DataType="vm:StockMovementsViewModel"
             Background="#0C0E14">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="40,32,40,0" Spacing="6">
            <TextBlock Text="Stok Hareketleri" FontSize="28" FontWeight="Bold" Foreground="#F1F5F9"/>
            <TextBlock Text="Depo giriş ve çıkış kayıtları" FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- Filtreler -->
        <Border Grid.Row="1" Background="#161B27" Margin="40,20,40,0"
                CornerRadius="12" Padding="20,14"
                BorderBrush="#1E2D45" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,8">
                    <TextBlock Text="Stok:" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding StockItems}"
                              SelectedIndex="{Binding SelectedStockIndex}"
                              Width="200"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,8">
                    <TextBlock Text="Tür:" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding TypeItems}"
                              SelectedIndex="{Binding SelectedTypeIndex}"
                              Width="110"/>
                </StackPanel>

                <TextBox Text="{Binding SearchText}"
                         Watermark="🔍 Stok adı, departman, kişi..."
                         Width="230" Margin="0,0,10,8"/>

                <CalendarDatePicker SelectedDate="{Binding StartDate}" Width="150" Margin="0,0,10,8" Watermark="Başlangıç"/>
                <CalendarDatePicker SelectedDate="{Binding EndDate}" Width="150" Margin="0,0,10,8" Watermark="Bitiş"/>

                <Button Content="🔍 Filtrele" Classes="Primary"
                        Command="{Binding LoadMovementsCommand}"
                        Margin="0,0,8,8"/>
                <Button Content="↺ Temizle" Classes="Secondary"
                        Command="{Binding ClearFiltersCommand}"
                        Margin="0,0,8,8"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="40,14,40,0">
            <Button Content="＋ Ekle" Classes="Primary" Command="{Binding AddMovementCommand}"/>
            <Button Content="📦 Toplu Hareket" Classes="Secondary" Command="{Binding BulkMovementCommand}"/>
            <Button Content="✎ Düzenle" Classes="Secondary" Command="{Binding EditMovementCommand}" IsEnabled="{Binding IsMovementSelected}"/>
            <Button Content="🗑 Sil" Classes="Danger" Command="{Binding DeleteMovementCommand}" IsEnabled="{Binding IsMovementSelected}"/>
            <Button Content="🗑 Toplu Sil" Classes="Danger" Command="{Binding DeleteBulkCommand}" IsEnabled="{Binding IsMultipleSelected}"/>
            
            <Rectangle Width="1" Height="22" Fill="#1E2D45" Margin="4,0"/>
            
            <Button Content="📥 İçe Aktar (Excel)" Classes="Secondary" Command="{Binding ImportXlsxCommand}"/>
            <Button Content="📄 Örnek İçe Aktar" Classes="Secondary" Command="{Binding ExportSampleCommand}"/>
            <Button Content="🖨 Yazdır" Classes="Secondary" Command="{Binding PrintCommand}"/>
            <Button Content="📊 Dışarı Aktar (Excel)" Classes="Secondary" Command="{Binding ExportExcelCommand}"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3"
                  Name="MovementsGrid"
                  Margin="40,16,40,16"
                  ItemsSource="{Binding Movements}"
                  SelectedItem="{Binding SelectedMovement}"
                  SelectionMode="Extended"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  Background="#0C0E14"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod"         Binding="{Binding StokKartKodNo}"  Width="80"/>
                <DataGridTextColumn Header="Stok Adı"    Binding="{Binding StokKartAd}"     Width="250"/>
                
                <DataGridTemplateColumn Header="G/Ç" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:StokHareketi">
                            <TextBlock Text="{Binding DisplayTur}" 
                                       Foreground="{Binding DisplayColor}" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Miktar" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:StokHareketi">
                            <TextBlock Text="{Binding Miktar}" 
                                       Foreground="{Binding DisplayColor}" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Departman"   Binding="{Binding Departman}"       Width="180"/>
                <DataGridTextColumn Header="Teslim"      Binding="{Binding TeslimEdilen}"    Width="210"/>
                <DataGridTextColumn Header="Tarih"       Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="200"/>
                <DataGridTextColumn Header="Açıklama"    Binding="{Binding Aciklama}"        Width="*"/>
                
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="#0E1119" Padding="40,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="◀" Command="{Binding PrevPageCommand}" Classes="Secondary" Padding="8,2"/>
                    <TextBlock Text="{Binding CurrentPage}" Foreground="#F1F5F9" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="/" Foreground="#475569" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPages}" Foreground="#475569" VerticalAlignment="Center"/>
                    <Button Content="▶" Command="{Binding NextPageCommand}" Classes="Secondary" Padding="8,2"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
