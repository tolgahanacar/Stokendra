<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StokTakip.Views.ServicesView"
             Background="#0C0E14">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="40,32,40,0" Spacing="6">
            <TextBlock Text="Servis Kayıtları" FontSize="28" FontWeight="Bold" Foreground="#F1F5F9"/>
            <TextBlock Text="Cihaz bakım ve onarım geçmişi" FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- Filtreler -->
        <Border Grid.Row="1" Background="#161B27" Margin="40,20,40,0"
                CornerRadius="12" Padding="20,14"
                BorderBrush="#1E2D45" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchText}"
                         Watermark="🔍 Cihaz adı, seri no, firma..."
                         Width="260" Margin="0,0,10,8"/>
                <Button Content="🔍 Ara" Classes="Primary"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,8,8"/>
                <Button Content="↺ Temizle" Classes="Secondary"
                        Command="{Binding ClearFiltersCommand}"
                        Margin="0,0,8,8"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="40,14,40,0">
            <Button Content="＋ Ekle" Classes="Primary"
                    Command="{Binding AddCommand}"/>
            <Button Content="✎ Düzenle" Classes="Secondary"
                    Command="{Binding EditCommand}"
                    IsEnabled="{Binding IsRecordSelected}"/>
            <Button Content="🗑 Sil" Classes="Danger"
                    Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding IsRecordSelected}"/>
            <Rectangle Width="1" Height="22" Fill="#1E2D45" Margin="4,0"/>
            <Button Content="📊 Excel" Classes="Secondary"
                    Command="{Binding ExportExcelCommand}"/>
            <Button Content="↺ Yenile" Classes="Secondary"
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3"
                  Margin="40,16,40,16"
                  ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  Background="#0C0E14"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cihaz Adı"  Binding="{Binding CihazAdi}"     Width="250"/>
                <DataGridTextColumn Header="Seri No"    Binding="{Binding SeriNumarasi}"  Width="200"/>
                <DataGridTextColumn Header="Firma"      Binding="{Binding Firma}"         Width="180"/>
                <DataGridTextColumn Header="Sorun"      Binding="{Binding Sorun}"         Width="250"/>
                <DataGridTextColumn Header="Sonuç"      Binding="{Binding Sonuc}"         Width="250"/>
                <DataGridTextColumn Header="Tarih"      Binding="{Binding BakimTarihi, StringFormat=dd.MM.yyyy}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="#0E1119" Padding="40,8">
            <TextBlock Text="{Binding StatusText}" Foreground="#475569" FontSize="12"/>
        </Border>

    </Grid>
</UserControl>
