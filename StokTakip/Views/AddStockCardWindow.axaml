<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StokTakip.ViewModels"
        x:Class="StokTakip.Views.AddStockCardWindow"
        Title="{Binding Title}"
        Width="520" Height="680"
        MinWidth="460" MinHeight="480"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#161B27">

    <Design.DataContext>
        <vm:AddStockCardViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#1C222E"
                Padding="20,16,20,14">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding Title}"
                           FontSize="18" FontWeight="Bold" Foreground="#E8EEFF"/>
                <TextBlock Text="Stok kartı bilgilerini giriniz"
                           FontSize="12" Foreground="#5A6987"/>
            </StackPanel>
        </Border>

        <!--
            ScrollViewer: Padding KULLANMA.
            Avalonia'da ScrollViewer.Padding bottom değeri scroll extent'e
            dahil edilmez — son eleman footer'ın arkasında kalır.
            Bunun yerine StackPanel'e Margin ver.
        -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14"
                        Margin="20,16,20,16">

                <!-- Kart Tipi + Stok Kodu -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                        <TextBlock Text="Kart Tipi" FontSize="12" Foreground="#8A9BBF"/>
                        <ComboBox SelectedIndex="{Binding SelectedTypeIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="📦 Alt Kart"/>
                            <ComboBoxItem Content="📁 Üst Kart (Grup)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                        <TextBlock Text="Stok Kodu" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding KodNo}" Watermark="Örn: 001"/>
                    </StackPanel>
                </Grid>

                <!-- Stok Adı -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Stok Adı" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding Ad}" Watermark="Ürün adı giriniz..."/>
                </StackPanel>

                <!-- Bağlı Üst Kart -->
                <StackPanel Spacing="5" IsVisible="{Binding IsAltCard}">
                    <TextBlock Text="Bağlı Üst Kart" FontSize="12" Foreground="#8A9BBF"/>
                    <ComboBox ItemsSource="{Binding ParentCards}"
                              SelectedItem="{Binding SelectedParent}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="(Yok)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Kategori + Birim -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                        <TextBlock Text="Kategori" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding Kategori}" Watermark="Örn: Toner"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                        <TextBlock Text="Birim" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding Birim}" Watermark="Adet, Kg..."/>
                    </StackPanel>
                </Grid>

                <!-- Min Stok + Birim Fiyat -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                        <TextBlock Text="Min Stok" FontSize="12" Foreground="#8A9BBF"/>
                        <NumericUpDown Value="{Binding MinStok}"
                                       Minimum="0"
                                       HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                        <TextBlock Text="Birim Fiyat" FontSize="12" Foreground="#8A9BBF"/>
                        <NumericUpDown Value="{Binding BirimFiyat}"
                                       Minimum="0"
                                       FormatString="N2"
                                       HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <!-- Açıklama -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Açıklama" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding Aciklama}"
                             Watermark="Ek bilgiler..."
                             Height="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Konum + Tedarikçi -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                        <TextBlock Text="Konum" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding Konum}" Watermark="Raf no vs."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                        <TextBlock Text="Tedarikçi" FontSize="12" Foreground="#8A9BBF"/>
                        <TextBox Text="{Binding Tedarikci}"/>
                    </StackPanel>
                </Grid>

                <!-- Barkod -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Barkod" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding Barkod}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#1C222E"
                Padding="20,14,20,14"
                BorderBrush="#252D3D"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="İptal"
                        Classes="Secondary"
                        Command="{Binding CancelCommand}"
                        Width="90" MinHeight="36"/>
                <Button Content="Kaydet"
                        Classes="Primary"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding Ad,
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Width="90" MinHeight="36"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
