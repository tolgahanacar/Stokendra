<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StokTakip.ViewModels"
        x:Class="StokTakip.Views.AddMovementView"
        Title="{Binding Title}"
        Width="450" Height="560"
        MinWidth="400" MinHeight="460"
        MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#161B27">

    <Design.DataContext>
        <vm:AddMovementViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="#1C222E" Padding="20,16,20,14">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding Title}"
                           FontSize="18" FontWeight="Bold" Foreground="#E8EEFF"/>
                <TextBlock Text="Hareket detaylarını giriniz"
                           FontSize="12" Foreground="#5A6987"/>
            </StackPanel>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="20,14,20,16">

                <StackPanel Spacing="5">
                    <TextBlock Text="Stok Kartı" FontSize="12" Foreground="#8A9BBF"/>
                    <ComboBox ItemsSource="{Binding AllCards}"
                              SelectedItem="{Binding SelectedCard}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                        <TextBlock Text="İşlem Türü" FontSize="12" Foreground="#8A9BBF"/>
                        <ComboBox SelectedIndex="{Binding SelectedTypeIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="📥 Giriş"/>
                            <ComboBoxItem Content="📤 Çıkış"/>
                            <ComboBoxItem Content="⚪ Boş"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                        <TextBlock Text="Miktar" FontSize="12" Foreground="#8A9BBF"/>
                        <NumericUpDown Value="{Binding Quantity}"
                                       Minimum="0"
                                       FormatString="N2"
                                       HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="5">
                    <TextBlock Text="Departman" FontSize="12" Foreground="#8A9BBF"/>
                    <ComboBox ItemsSource="{Binding AllDepartments}"
                              SelectedItem="{Binding Department}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Teslim Edilen / Alınan" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding DeliveredTo}" Watermark="İsim yazınız..."/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Tarih" FontSize="12" Foreground="#8A9BBF"/>
                    <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Açıklama" FontSize="12" Foreground="#8A9BBF"/>
                    <TextBox Text="{Binding Description}"
                             Watermark="Not ekleyin..."
                             Height="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer — always visible -->
        <Border Grid.Row="2"
                Background="#1C222E"
                Padding="20,14,20,14"
                BorderBrush="#252D3D"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Error message — stays in footer, never pushes content -->
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="#FF453A"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           IsVisible="{Binding ErrorMessage,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="İptal"
                            Classes="Secondary"
                            Command="{Binding CancelCommand}"
                            Width="90" MinHeight="36"/>
                    <Button Content="Kaydet"
                            Classes="Primary"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding SelectedCard,
                                Converter={x:Static ObjectConverters.IsNotNull}}"
                            Width="90" MinHeight="36"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
