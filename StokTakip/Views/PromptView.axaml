<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StokTakip.ViewModels"
        x:Class="StokTakip.Views.PromptView"
        Title="{Binding Title}"
        Width="350" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#161B27"
        ExtendClientAreaToDecorationsHint="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="{Binding Message}" Foreground="#94A3B8" Margin="0,0,0,12"/>
        
        <TextBox Grid.Row="1" Text="{Binding InputText}" 
                 Watermark="Değer giriniz..."
                 VerticalAlignment="Top"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="İptal" Command="{Binding CancelCommand}" Classes="Secondary"/>
            <Button Content="Tamam" Command="{Binding OkCommand}" Classes="Primary"/>
        </StackPanel>
    </Grid>
</Window>
