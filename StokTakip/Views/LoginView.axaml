<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StokTakip.ViewModels"
        x:Class="StokTakip.Views.LoginView"
        Title="Stokendra - Giriş"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#0C0E14">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="#0E1119" Padding="0,32,0,24">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="STOKENDRA"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#38AEFF"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Stok Takip Sistemi"
                           FontSize="11"
                           Foreground="#5A6987"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Padding="40,24,40,24">
            <StackPanel Spacing="0">

                <!-- Kullanıcı Adı -->
                <TextBlock Text="Kullanıcı Adı"
                           Foreground="#B9C3DC"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, Mode=TwoWay}"
                         Watermark="Kullanıcı adınızı girin"
                         Margin="0,0,0,18"/>

                <!-- Şifre -->
                <TextBlock Text="Şifre"
                           Foreground="#B9C3DC"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding Password, Mode=TwoWay}"
                         PasswordChar="●"
                         Watermark="Şifrenizi girin"
                         Margin="0,0,0,8"/>

                <!-- Hata mesajı -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FF4B4B"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>

                <!-- Giriş Butonu -->
                <Button Content="Giriş Yap"
                        Command="{Binding DoLoginCommand}"
                        IsDefault="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="44"
                        Margin="0,16,0,0"
                        FontSize="13" FontWeight="SemiBold"/>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 Tolgahan Acar"
                   Foreground="#3A4560"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>
    </Grid>
</Window>
